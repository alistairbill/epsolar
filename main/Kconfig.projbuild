menu "EPSolar Zigbee sensor"

config EPSOLAR_UPDATE_INTERVAL_SECONDS
    int "Telemetry update interval (seconds)"
    range 1 86400
    default 60
    help
        Time between Modbus reads and Zigbee attribute updates.

config EPSOLAR_MODBUS_UART_PORT
    int "Modbus UART port"
    range 0 1
    default 1
    help
        UART0 and UART1 are the ESP32-C6 high-performance UARTs. UART1 is
        used by default so USB Serial/JTAG remains available for logs.

config EPSOLAR_MODBUS_TX_GPIO
    int "Modbus UART TX GPIO"
    range 0 30
    default 16
    help
        XIAO D6, labelled TX.

config EPSOLAR_MODBUS_RX_GPIO
    int "Modbus UART RX GPIO"
    range 0 30
    default 17
    help
        XIAO D7, labelled RX.

config EPSOLAR_MODBUS_BAUD_RATE
    int "Modbus baud rate"
    range 1200 115200
    default 115200

config EPSOLAR_MODBUS_SLAVE_ADDRESS
    int "Modbus slave address"
    range 1 247
    default 1

endmenu
